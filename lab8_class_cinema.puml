@startuml
title Диаграмма классов. Онлайн-кинотеатр

class Зритель {
  -id : int
  -email : string
  +оформитьПодписку() : Подписка
}
class Фильм {
  -id : int
  -название : string
  -описание : string
  -год : int
}
class Сеанс {
  -id : int
  -время : datetime
  -зал : string
}
class Подписка {
  -id : int
  -тариф : Тариф
  -датаОкончания : date
  +активна() : bool
}
class Просмотр {
  -id : int
  -начало : datetime
  -окончание : datetime
  -пауза : int
}
class Администратор {
  -id : int
  +управлятьКаталогом() : void
}
enum Тариф {
  Базовый
  Премиум
}

Зритель "1" --> "0..*" Подписка : имеет
Зритель "0..*" --> "0..*" Просмотр : смотрит
Просмотр "0..1" --> "1" Фильм : фильм
Просмотр "0..*" --> "1" Сеанс : сеансы
Администратор "0..*" --> "0..*" Фильм : управляет
Администратор "0..*" --> "0..*" Сеанс : управляет
Подписка ..> Тариф
@enduml
