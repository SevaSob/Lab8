@startuml
title Диаграмма классов. Онлайн-доставка еды

class Клиент {
  -id : int
  -имя : string
  -телефон : string
  +оформитьЗаказ() : Заказ
}
class Ресторан {
  -id : int
  -название : string
  -адрес : string
  +меню() : list<Блюдо>
  +подтвердитьЗаказ() : void
}
class Заказ {
  -id : int
  -создан : datetime
  -статус : СтатусЗаказа
  -сумма : decimal
  +статус() : СтатусЗаказа
  +добавитьБлюдо() : void
}
class Блюдо {
  -id : int
  -название : string
  -цена : decimal
}
class ПозицияЗаказа {
  -количество : int
  -цена : decimal
}
class Курьер {
  -id : int
  -имя : string
  +взятьЗаказ() : void
  +доставить() : void
}
class Оплата {
  -id : int
  -сумма : decimal
  -статус : СтатусОплаты
}
enum СтатусЗаказа {
  Создан
  Оплачен
  В_работе
  Доставлен
}
enum СтатусОплаты {
  НеОплачен
  Оплачен
  Отказ
}

Клиент "1" --> "0..*" Заказ : оформляет
Ресторан "1" -- "0..*" Заказ : выполняет
Заказ "1" *-- "1..*" ПозицияЗаказа : содержит
ПозицияЗаказа "0..*" --> "1" Блюдо : ссылается
Заказ "0..1" --> "1" Оплата : оплачен
Курьер "0..*" --> "0..1" Заказ : доставляет
Заказ ..> СтатусЗаказа
Оплата ..> СтатусОплаты
@enduml
